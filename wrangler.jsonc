{
  "name": "inside-grey-room-last",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-09-28",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
